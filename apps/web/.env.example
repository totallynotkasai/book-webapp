# Copy to .env.local to change these for `npm run dev` or `npm run build`. Nothing here is secret.

# Build profile (DESIGN.md P0-09): `owner` (default) has every area and the dev panel at /dev;
# `tester` shows only the reading experience and hides the dev panel. `npm run build:tester`
# builds the tester profile into build-tester/ (via .env.tester).
VITE_PROFILE=owner

# Tester builds only: simulated areas to include for a PoC review session, comma-separated.
# Any of: store, studio, community, admin. Empty means reading only. Ignored by owner builds.
# A facilitator link (?areas=store,community) adds areas on one device instead (D-031).
VITE_FLAGS=

# Which build this is (e.g. "2026-10-13 · a1b2c3d"), shown in You → Help so PoC review notes can
# say which build a tester used. The deploy workflow sets it; empty shows nothing.
VITE_BUILD_ID=

# Not a VITE_ variable, so it never reaches the app's code: the folder a static host serves the
# app from, e.g. /book-webapp for a GitHub Pages project site (D-029). Empty serves it from the
# root, which Capacitor and the E2E server need. Set it in the environment of `npm run build`.
# BASE_PATH=
