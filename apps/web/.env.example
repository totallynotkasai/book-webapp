# Copy to .env.local to change these for `npm run dev` or `npm run build`. Nothing here is secret.

# Build profile (DESIGN.md P0-09): `owner` (default) has every area and the dev panel at /dev;
# `tester` shows only the reading experience and hides the dev panel. `npm run build:tester`
# builds the tester profile into build-tester/ (via .env.tester).
VITE_PROFILE=owner

# Tester builds only: simulated areas to include for a PoC review session, comma-separated.
# Any of: store, studio, community, admin. Empty means reading only. Ignored by owner builds.
VITE_FLAGS=
