{
	"name": "@book/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:tester": "vite build --mode tester",
		"budget": "node scripts/budget.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:perf": "playwright test -c playwright.perf.config.ts",
		"serve": "node scripts/serve.mjs build 4173",
		"cap:sync": "npm run build && cap sync android",
		"cap:android": "npm run cap:sync && node scripts/android.mjs",
		"apk:tester": "npm run build:tester && node scripts/android.mjs --web build-tester --release --no-install",
		"cap:open": "cap open android",
		"icons": "node scripts/icons.mjs",
		"predev": "node scripts/ensure-layers.mjs",
		"prebuild": "node scripts/ensure-layers.mjs",
		"prebuild:tester": "node scripts/ensure-layers.mjs"
	},
	"dependencies": {
		"@book/alignment": "*",
		"@book/backend-local": "*",
		"@book/core": "*",
		"@book/domain": "*",
		"@book/reader-core": "*",
		"@book/storage-local": "*",
		"@book/tokens": "*",
		"@book/ui": "*",
		"@capacitor/android": "^8.5.2",
		"@capacitor/app": "8.1.1",
		"@capacitor/core": "^8.5.2",
		"@capacitor/filesystem": "8.1.3",
		"@capacitor/share": "8.0.2",
		"@internationalized/date": "3.12.4",
		"@material/material-color-utilities": "0.4.0",
		"bits-ui": "2.19.3",
		"fflate": "0.8.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@capacitor/cli": "^8.5.2",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
